pipeline {
    agent any

    tools {
        nodejs 'NodeJS-22'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install and Test') {
            steps {
                // Uses install to bypass lockfile issues
                sh 'npm install'
                sh 'npm test -- --watchAll=false'
            }
        }

        stage('Coverage') {
            steps {
                sh 'npm test -- --coverage --watchAll=false'
            }
        }

                stage('SonarQube Analysis') {
            when {
                branch 'main' 
            }
            steps {                
                script {
                    def scannerHome = tool 'SonarScanner'
                    withSonarQubeEnv('SonarQube') {
                        sh "${scannerHome}/bin/sonar-scanner -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info"
                    }
                }
            }
        }

        stage('Quality Gate') {
            when {
                branch 'main'
            }
            steps {
                // Waits for SonarQube to approve the code
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build') {
            when {
                anyOf {
                    branch 'main'
                    branch 'develop'
                }
            }
            steps {
                sh 'npm run build'
            }
        }

        stage('Archive Artifact') {
            when {
                branch 'main'
            }
            steps {
                sh 'tar -czf react-app-${BUILD_NUMBER}.tar.gz build/ Dockerfile'
                archiveArtifacts artifacts: 'react-app-*.tar.gz', fingerprint: true
            }
        }
    }
}